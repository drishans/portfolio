---
/**
 * Draft mode's control bar: which file this page came from, and a button that
 * flips its `draft` flag on disk. Rendered only under `npm run dev:drafts`, by
 * Base.astro, for the layouts that pass a `draftOf`.
 *
 * Styles live in src/dev/draft-mode.css (see the note there).
 *
 * The <script> must stay `is:inline`. Astro hoists and bundles a plain
 * <script> onto every page that uses the component, conditional or not, so an
 * unmarked one here would ship in `astro build` and quietly break the
 * zero-client-JS rule. `is:inline` is emitted where it is written and nowhere
 * else, which means it disappears along with the branch around it.
 */
import { SHOW_DRAFTS } from '../utils';

interface Props {
  /** Content collection this page renders from. */
  collection: string;
  /** Entry id, the loader's path-without-extension (folders included). */
  id: string;
  draft: boolean;
}
const { collection, id, draft } = Astro.props;
---

{SHOW_DRAFTS && (
  <aside class="draft-bar" data-draft={draft ? 'true' : 'false'} aria-label="Draft controls">
    <span class="draft-bar__state mono">{draft ? 'Draft' : 'Live'}</span>
    <span class="draft-bar__path mono">{collection}/{id}</span>
    <button
      class="draft-bar__flip mono"
      type="button"
      data-collection={collection}
      data-id={id}
      data-next={draft ? 'false' : 'true'}
    >
      {draft ? 'Publish →' : '← Back to draft'}
    </button>
    <a class="draft-bar__all mono" href="/__drafts">All drafts</a>
  </aside>

  <script is:inline>
    document.querySelector('.draft-bar__flip')?.addEventListener('click', async (event) => {
      const el = event.currentTarget;
      el.disabled = true;
      const res = await fetch('/__drafts/toggle', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          collection: el.dataset.collection,
          id: el.dataset.id,
          draft: el.dataset.next === 'true',
        }),
      });
      if (!res.ok) {
        el.disabled = false;
        const { error } = await res.json().catch(() => ({ error: res.statusText }));
        alert('Could not flip that: ' + error);
        return;
      }
      // The file changed, so the content layer is about to reload anyway;
      // reloading here just makes the bar agree with it immediately.
      location.reload();
    });
  </script>
)}

